---
import Base from '../../../layouts/Base.astro';
import PageHeading from '../../../components/PageHeading.astro';
import { referenceTerms } from '../../../lib/references';
import sources from '../../../data/sources.json';
import { locales, path, type Locale } from '../../../lib/i18n';
import '../../../styles/reference.css';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
const categories = en ? {combat:'Combat',investigation:'Investigation',places:'Places & setting',event:'Event rules',items:'Event items',characters:'Characters'} : {combat:'戦闘',investigation:'調査・推理',places:'地域・設定',event:'イベント',items:'イベントアイテム',characters:'人物'};
---
<Base locale={locale} title={en ? 'English–Japanese game reference' : '英日ゲーム用語リファレンス'} description={en ? 'Find official English and Japanese Silver Palace character names, combat terms, deduction actions, places and event items with source-backed explanations.' : '白銀の城の英日公式名を検索。人物、戦闘用語、推理の操作、地域、イベントアイテムを出典付きで確認できます。'} section="tools">
<div class="shell" id="reference-library" data-locale={locale} data-pagefind-body>
  <PageHeading locale={locale} eyebrow={en ? 'THE ARCHIVE / LANGUAGE REFERENCE' : '資料室 / 用語リファレンス'} title={en ? 'Two languages. The same clue.' : '言葉が違っても、同じ手がかりへ。'} description={en ? 'Match official names across English and Japanese. Search in either language, then follow the reference into a guide or character dossier.' : '英語と日本語の公式名を照合できます。どちらの言語でも検索し、ガイドや人物資料へ進めます。'}/>
  <p class="notice">{en ? 'Combat and deduction terms follow the July 2026 official test articles. Event terms follow the public rules checked on 22 November 2026. Development terms also cite the August feedback, which describes plans rather than confirmed launch changes. Names and descriptions do not establish final launch mechanics or character strength. Guide interface labels are kept separate from this official-name reference.' : '戦闘・推理用語は2026年7月の公式テスト紹介、イベント用語は2026年11月22日に確認した公開ルールに基づきます。開発関連の用語は8月のフィードバックも参照し、改善計画を正式版の実装済み機能とは区別しています。名前や紹介文だけで正式版の仕様や人物の強さは判断できません。サイト独自の画面用語はこの公式名リファレンスに含めていません。'}</p>
  <div class="reference-search" data-pagefind-ignore><label class="field-label" for="term-query">{en ? 'Search English or Japanese names and descriptions' : '英語・日本語の名前と説明を検索'}</label><input class="field" id="term-query" type="search" autocomplete="off" maxlength="150" placeholder={en ? 'Try parry, 推理弾 or Alf' : '例：パリィ、Simulation Shot、フウ'}/><div class="zone-control" style="margin:16px 0 0"><label class="field-label" for="term-category">{en ? 'Category' : '分類'}</label><select id="term-category"><option value="">{en ? 'All references' : 'すべて'}</option>{Object.entries(categories).map(([id,label]) => <option value={id}>{label}</option>)}</select><button class="text-link" id="term-clear" type="button">{en ? 'Clear filters' : '絞り込みを解除'}</button></div><p class="status-message" id="term-count" role="status" aria-live="polite">{en ? `${referenceTerms.length} references` : `${referenceTerms.length}件の資料`}</p></div>
  <p id="term-empty" class="notice" hidden data-pagefind-ignore>{en ? 'No match. Try a shorter name, another language or clear the category filter.' : '一致する資料がありません。短い名前、別の言語、分類の解除をお試しください。'}</p>
  <div class="term-list">{referenceTerms.map((term) => {
    const sourceId = term.sourceIds.find(id => id.endsWith(en ? '-en' : '-ja')) ?? term.sourceIds[0];
    const source = sources.find(source => source.id === sourceId)!;
    const [suffix, anchor] = term.guide.split('#');
    return <article class="term-card" id={term.id} data-term-card data-term-category={term.category} data-term-text={`${term.en} ${term.ja} ${term.definition.en} ${term.definition.ja}`}><span class="eyebrow">{categories[term.category as keyof typeof categories]}</span><h2>{term[locale]}</h2><p class="term-alternate" lang={en ? 'ja' : 'en'}>{term[en ? 'ja' : 'en']}</p><p>{term.definition[locale]}</p><a class="text-link" href={`${path(locale,suffix)}${anchor ? `#${anchor}` : ''}`}>{en ? 'Read the related reference →' : '関連資料を読む →'}</a><p class="tiny"><a href={source.url} target="_blank" rel="noopener noreferrer">{en ? 'Official source ↗' : '公式の出典 ↗'}</a> · {term.checkedAt}</p></article>;
  })}</div>
  <noscript><p class="notice">{en ? 'All references are available below without JavaScript. Enable it for name search and category filters.' : 'JavaScriptなしでも全資料を読めます。検索と分類の絞り込みにはJavaScriptが必要です。'}</p></noscript>
</div>
</Base>
<script>
  import { matchesReference } from '../../../lib/reference-search';
  const root = document.querySelector<HTMLElement>('#reference-library');
  if (root) {
    const en = root.dataset.locale === 'en', query = root.querySelector<HTMLInputElement>('#term-query')!, category = root.querySelector<HTMLSelectElement>('#term-category')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-term-card]')];
    function filter() {
      let count = 0;
      cards.forEach(card => { const show = (!category.value || card.dataset.termCategory === category.value) && matchesReference(query.value, card.dataset.termText!); card.hidden = !show; if (show) count++; });
      root!.querySelector('#term-count')!.textContent = en ? `${count} of ${cards.length} references` : `${cards.length}件中${count}件`;
      root!.querySelector<HTMLElement>('#term-empty')!.hidden = count > 0;
    }
    query.addEventListener('input',filter); category.addEventListener('change',filter);
    root.querySelector('#term-clear')!.addEventListener('click',()=>{ query.value=''; category.value=''; filter(); query.focus(); });
  }
</script>
