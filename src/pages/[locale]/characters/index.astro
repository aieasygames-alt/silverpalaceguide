---
import Base from '../../../layouts/Base.astro';
import PageHeading from '../../../components/PageHeading.astro';
import Icon from '../../../components/Icon.astro';
import CharacterPortrait from '../../../components/CharacterPortrait.astro';
import ProfileFacts from '../../../components/ProfileFacts.astro';
import SourceList from '../../../components/SourceList.astro';
import { characterProfiles } from '../../../lib/character-profiles';
import { characterDetails, characterHref } from '../../../lib/character-details';
import { locales, path, type Locale } from '../../../lib/i18n';
import '../../../styles/characters.css';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
const other = en ? 'ja' : 'en';
---
<Base locale={locale} title={en ? 'Characters & official profiles' : 'キャラクター・公式紹介まとめ'} description={en ? 'Meet the Silver Palace cast: official English and Japanese names, character backgrounds, equipment and combat details, with sources.' : '白銀の城のキャラクターを公式発表から紹介。英日公式名、人物像、装備、確認できる戦闘情報を出典とともに整理。'} section="characters">
  <div class="shell" data-pagefind-body>
    <PageHeading locale={locale} eyebrow={en ? 'THE CHARACTER ARCHIVE' : 'キャラクター資料室'} title={en ? 'Faces behind the stories.' : '物語をつなぐ、人々。'} description={en ? 'Meet the people of Silvernia through their official introductions. English and Japanese names sit together, so a familiar face is easier to find.' : '公式のキャラクター紹介から、シルバニアの人々を知る。英語名と日本語名を併記し、気になる人物を探しやすくしました。'}/>
    <div class="roster-brief">
      <div><span class="eyebrow">{en ? 'OFFICIAL INTRODUCTIONS' : '公式紹介をもとに作成'}</span><p>{en ? '20 character dossiers · 21 displayed identities, including both Detective introductions. This directory is not a confirmed playable launch roster.' : '20件の人物資料・主役の2つの姿を含む21の紹介。正式版でプレイ可能なキャラクター一覧を示すものではありません。'}</p></div>
      <div><span class="pill">{en ? 'CHECKED 22 NOV 2026' : '確認日 2026年11月22日'}</span><a class="text-link" href={path(locale, 'tools/character-compare')}>{en ? 'Compare official profiles' : '公式資料を比較する'}<Icon name="arrow" size={16}/></a></div>
    </div>
    <p class="tiny roster-scope">{en ? 'Pre-release profiles, summarized without later plot developments. Builds and upgrade costs await verified data.' : 'リリース前の公式紹介を、後半の展開を避けて要約しています。育成攻略と必要素材は、確認できた情報から追加します。'}</p>
    <section aria-label={en ? 'Find a character' : 'キャラクターを探す'} class="roster-search" data-pagefind-ignore>
      <label class="field-label" for="character-search">{en ? 'Find by English or Japanese name' : '英語名・日本語名で探す'}</label>
      <input class="field" id="character-search" type="search" placeholder={en ? 'Alf, フウ, Argos…' : 'フウ、Alf、アーガス…'} autocomplete="off" aria-describedby="roster-count"/>
      <p id="roster-count" class="tiny" role="status" aria-live="polite" data-locale={locale}>{en ? '20 dossiers' : '20件の人物資料'}</p>
    </section>
    <div class="roster-grid">
      {characterProfiles.map((profile, index) => <article id={profile.id} class="character-card" data-profile-card data-search={`${profile.name.en} ${profile.name.ja} ${profile.titles.en.join(' ')} ${profile.titles.ja.join(' ')}`}>
        <header><div class="portrait-pair">{profile.portraitIds.map((id) => <CharacterPortrait id={id}/>)}</div><span class="dossier-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></header>
        <span class="eyebrow">{profile.coverage === 'profile' ? (en ? 'OFFICIAL PROFILE' : '公式プロフィール') : (en ? 'BRIEF INTRODUCTION' : '短い公式紹介')}</span>
        <h2><a href={characterHref(locale, profile.id)}>{profile.name[locale]}</a></h2>
        <p class="alternate-name" lang={other}>{profile.name[other]}</p>
        <p class="character-title">{profile.titles[locale].join(' / ')}</p>
        <p>{profile.summary[locale]}</p>
        <details><summary>{en ? 'Equipment & combat notes' : '装備・戦闘情報を見る'}</summary><ProfileFacts profile={profile} locale={locale}/></details>
        {characterDetails.some(detail => detail.id === profile.id) && <p class="character-detail-link"><a class="text-link" href={characterHref(locale, profile.id)}>{en ? 'Read the full background & equipment dossier →' : '人物像と装備の詳しい資料を読む →'}</a></p>}
        <div class="character-links"><a class="text-link" href={`${path(locale, 'tools/character-compare')}?a=${profile.id}`}>{en ? 'Compare' : '比較する'}<Icon name="arrow" size={14}/></a><a class="tiny" href={`https://silverpalace.elementagames.com/${en ? 'en-us' : 'ja-jp'}/roles`} target="_blank" rel="noopener noreferrer">{en ? 'Official source ↗' : '公式の出典 ↗'}</a></div>
      </article>)}
    </div>
    <p id="roster-empty" class="notice" hidden>{en ? 'No match. Try an English or Japanese name, or clear your search.' : '一致する人物がいません。英語名・日本語名で試すか、検索欄を空にしてください。'}</p>
    <noscript><p class="notice">{en ? 'All dossiers are shown. Enable JavaScript to filter them by name.' : 'すべての資料を表示しています。名前での絞り込みにはJavaScriptが必要です。'}</p></noscript>
    <div class="roster-next panel"><h2>{en ? 'From a face to a plan.' : '気になる人物から、準備へ。'}</h2><p>{en ? 'Compare what the official introductions actually say, then use the material worksheet for requirements you can verify in-game. Titles are official epithets rather than gameplay classes. Rarity, acquisition, skill multipliers and upgrade costs are not established by these introductions.' : '公式に紹介された特徴を比較し、ゲーム内で必要数を確認できたら素材計画に進めます。称号は人物紹介用の表現で、ゲーム上のクラスではありません。この紹介では、レアリティ、入手方法、スキル倍率、育成費用は確認できません。'}</p><div class="button-row"><a class="button" href={path(locale, 'tools/character-compare')}>{en ? 'Open profile comparison' : '人物資料の比較へ'}<Icon name="arrow" size={16}/></a><a class="text-link" href={path(locale, 'tools/material-planner')}>{en ? 'Material worksheet' : '素材の計画表'}</a></div></div>
    <div class="button-row" style="margin-bottom:30px"><a class="text-link" href={path(locale, 'guides/combat-basics')}>{en ? 'Read the announced combat mechanics →' : '発表済みの戦闘システムを読む →'}</a><a class="text-link" href={path(locale, 'tools/glossary')}>{en ? 'Look up English and Japanese terms →' : '英日用語を調べる →'}</a></div><SourceList locale={locale} ids={['official-roles-en', 'official-roles-ja']}/>
  </div>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#character-search');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-profile-card]')];
  const count = document.querySelector<HTMLElement>('#roster-count');
  input?.addEventListener('input', () => {
    const query = input.value.normalize('NFKC').toLocaleLowerCase().trim();
    let visible = 0;
    for (const card of cards) {
      card.hidden = !card.dataset.search?.normalize('NFKC').toLocaleLowerCase().includes(query);
      if (!card.hidden) visible++;
    }
    if (count) count.textContent = count.dataset.locale === 'en' ? `${visible} of ${cards.length} dossiers` : `${cards.length}件中${visible}件を表示`;
    document.querySelector<HTMLElement>('#roster-empty')!.hidden = visible > 0;
  });
</script>
