{
  "name": "silver-palace-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "npm run verify:content && astro build && pagefind --site dist && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:content": "tsx scripts/verify-content.ts",
    "capture:new": "node scripts/new-capture.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "pagefind": "1.6.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
