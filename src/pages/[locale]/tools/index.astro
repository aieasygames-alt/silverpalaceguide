---
import Base from '../../../layouts/Base.astro';
import PageHeading from '../../../components/PageHeading.astro';
import Icon from '../../../components/Icon.astro';
import SourceList from '../../../components/SourceList.astro';
import { locales, path, type Locale } from '../../../lib/i18n';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
const tools = [
  { slug: 'tools/character-compare', icon: 'search' as const, tag: en ? 'OFFICIAL INTRODUCTIONS' : '公式紹介', title: en ? 'Character comparison' : 'キャラクター資料の比較', description: en ? 'Compare English and Japanese names, backgrounds and announced equipment. Share a link to the profiles you choose.' : '英日公式名、人物像、発表済みの装備を比較。選んだ人物の比較をリンクで共有できます。', action: en ? 'Compare profiles' : '人物資料を比較する' },
  { slug: 'tools/material-planner', icon: 'planner' as const, tag: en ? 'CUSTOM WORKSHEET' : '手入力の計画表', title: en ? 'Material planner' : '素材プランナー', description: en ? 'Enter verified required and owned quantities. See shortages, save locally and export your worksheet. Keep a character profile nearby.' : '確認した必要数と所持数から不足数を計算。人物資料を参照し、ブラウザーへの保存と書き出しができます。', action: en ? 'Make a plan' : '計画を立てる' },
  { slug: 'exploration', icon: 'compass' as const, tag: en ? 'PERSONAL NOTES' : '自分用のノート', title: en ? 'Exploration checklist' : '探索チェックリスト', description: en ? 'Keep your own tasks and places to revisit in one notebook. Mark things off as you explore Silvernia.' : '自分の目標や、後で訪れたい場所をノートに。探索が終わった項目をチェックできます。', action: en ? 'Open your notebook' : 'ノートを開く' },
];
---
<Base locale={locale} title={en ? 'Planning tools' : '計画ツール'} description={en ? 'Silver Palace tools: compare official character profiles, plan material shortages and keep a personal exploration checklist.' : '白銀の城のツール。公式人物資料の比較、素材の不足数計算、自分用の探索チェックリストを利用できます。'} section="tools">
  <div class="shell" data-pagefind-body>
    <PageHeading locale={locale} eyebrow={en ? 'THE WORKBENCH' : '探偵の作業机'} title={en ? 'A clearer next step.' : '次の一歩を、見つけやすく。'} description={en ? 'Get to know the cast. Plan your next upgrade. Keep track of a city full of possibilities. No account needed.' : '登場人物を知り、次の育成を計画し、街の発見を記録する。アカウント登録は不要です。'}/>
    <div class="feature-grid" style="margin-bottom:48px">{tools.map((tool, index) => <a class:list={['feature', { dark: index === 0 }]} href={path(locale, tool.slug)}><div class="feature-top"><Icon name={tool.icon} size={28}/><span>{String(index + 1).padStart(2, '0')} / {tool.tag}</span></div><h3>{tool.title}</h3><p>{tool.description}</p><div class="feature-bottom"><span>{tool.action}</span><Icon name="arrow" size={18}/></div></a>)}</div>
    <section class="panel" style="margin-bottom:40px"><h2>{en ? 'What the announcements tell us.' : '公式発表からわかること。'}</h2><p style="margin-top:16px">{en ? 'The official launch announcement describes detective investigations, open-world city exploration, real-time character switching and skill synergies. The profile comparison helps you learn the cast; your notebook can record places to revisit and your own observations. Character introductions add qualitative equipment details, but do not provide complete upgrade costs or enough data to calculate an optimal team.' : '公式のリリース発表では、探偵による調査、オープンワールドの街の探索、リアルタイムのキャラクター切り替え、スキルの連携が紹介されています。比較ツールで人物像を知り、ノートには再訪したい場所や気づきを記録できます。人物紹介には装備の特徴もありますが、育成費用の全容や最適編成を計算できるデータまでは確認できません。'}</p><p style="margin-top:16px">{en ? 'Your material worksheet and exploration notes stay in this browser unless you export them. Comparison links contain only selected character IDs.' : '素材計画と探索メモは、書き出さない限りこのブラウザーに保存されます。比較リンクには選んだ人物のIDだけを含めます。'}</p></section>
    <SourceList locale={locale} ids={['elementa-launch-20261031', 'official-roles-en', 'official-roles-ja']}/>
  </div>
</Base>
