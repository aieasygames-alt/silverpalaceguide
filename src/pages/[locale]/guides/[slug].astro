---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import GameImage from '../../../components/GameImage.astro';
import PageHeading from '../../../components/PageHeading.astro';
import { publishedGuides } from '../../../lib/content';
import sources from '../../../data/sources.json';
import { text, type Locale } from '../../../lib/i18n';
export async function getStaticPaths() { return (await publishedGuides()).map((guide) => ({ params: { locale: guide.data.locale, slug: guide.data.slug }, props: { guide } })); }
const { guide } = Astro.props;
const locale = guide.data.locale as Locale;
const en = locale === 'en';
const { Content } = await render(guide);
const references = sources.filter((source) => guide.data.sourceIds.includes(source.id));
---
<Base locale={locale} title={guide.data.title} description={guide.data.summary} section="guides"><div class="shell"><div data-pagefind-body><PageHeading locale={locale} eyebrow={en ? 'FIELD GUIDE' : 'フィールドガイド'} title={guide.data.title} description={guide.data.summary}/><div class="page-grid"><article class="prose">{guide.data.slug === 'launch-preparation' && <figure class="article-art" data-pagefind-ignore><GameImage image="launch" locale={locale} sizes="(max-width: 600px) calc(100vw - 36px), (max-width: 800px) 596px, (max-width: 1100px) calc(100vw - 346px), 596px"/><figcaption>{en ? 'Global launch promotional artwork. See the announcement below for the date and timezone.' : 'グローバルリリースの宣伝ビジュアル。日付とタイムゾーンは本文の公式発表をご確認ください。'}</figcaption></figure>}<Content /></article><aside data-pagefind-ignore><div class="panel"><span class="pill">{guide.data.verification === 'official-announcement' ? (en ? 'Official announcement' : '公式発表に基づく情報') : (en ? 'Editorial guide' : 'サイトの使い方')}</span><hr class="rule"/><dl class="meta-list"><div><dt>{en ? 'Scope' : '対象'}</dt><dd>{guide.data.gameVersion}</dd></div><div><dt>{en ? 'Updated' : '更新日'}</dt><dd><time datetime={guide.data.updatedAt}>{guide.data.updatedAt}</time></dd></div><div><dt>{en ? 'Edition' : '版'}</dt><dd>{en ? 'Global / International' : 'グローバル版'}</dd></div></dl><hr class="rule"/><h3 style="font-size:1.4rem">{text[locale].sources}</h3><ol class="source-list">{references.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a><br/>{text[locale].checked}: {source.checkedAt}</li>)}</ol></div></aside></div></div></div></Base>
