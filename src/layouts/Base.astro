---
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SiteBrand from '../components/SiteBrand.astro';
import { text, path, navPaths, type Locale } from '../lib/i18n';
interface Props { locale: Locale; title: string; description: string; section?: string; noindex?: boolean; alternatePath?: string; }
const { locale, title, description, section, noindex = false, alternatePath } = Astro.props;
const t = text[locale];
const pageTitle = title === 'Silver Palace Guide' ? title : `${title} — Silver Palace Guide`;
const shareImage = new URL(`/images/social/default-${locale}.jpg`, Astro.site);
const shareAlt = locale === 'en' ? 'Silver Palace Guide — an independent field guide for case notes, exploration and planning.' : 'Silver Palace Guide — 白銀の城の事件ヒント・探索・育成を扱う非公式攻略サイト。';
const suffix = Astro.url.pathname.replace(new RegExp(`^/${locale}/?`), '').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
const isPreview = import.meta.env.PREVIEW_NOINDEX === '1' || (import.meta.env.CF_PAGES === '1' && import.meta.env.CF_PAGES_BRANCH !== 'main');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && <><link rel="alternate" hreflang="en" href={new URL(path('en', alternatePath ?? suffix), Astro.site)} /><link rel="alternate" hreflang="ja" href={new URL(path('ja', alternatePath ?? suffix), Astro.site)} /><link rel="alternate" hreflang="x-default" href={new URL(path('en', alternatePath ?? suffix), Astro.site)} /></>}
    {(noindex || isPreview) && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Silver Palace Guide" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ja_JP'} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <meta name="theme-color" content="#193c35" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="utility"><div class="shell utility-inner"><span><span class="status-dot"></span>{t.unofficial}</span><a href={path(locale, 'guides/launch-preparation')}>{t.launch}<Icon name="diagonal" size={12}/></a></div></div>
    <header class="site-header" data-pagefind-ignore>
      <div class="shell masthead">
        <SiteBrand locale={locale}/>
        <span class="masthead-note">{locale === 'en' ? 'A little direction.\nA lot to discover.' : '少しのヒントで、\nもっと遠くへ。'}</span>
        <div class="masthead-actions"><a class="search-link" href={path(locale, 'search')} aria-label={t.search}><Icon name="search" size={18}/><span>{t.search}</span><kbd>/</kbd></a><a class="language-switch" href={path(t.otherLocale, alternatePath ?? suffix)} lang={t.otherLocale} aria-label={t.otherLanguage}>{t.otherLanguage}<span aria-hidden="true">↗</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">{t.menu}<Icon name="plus" size={18}/></button></div>
      </div>
      <div class="nav-wrap"><nav id="main-nav" class="shell main-nav" aria-label={locale === 'en' ? 'Main navigation' : 'メインナビゲーション'}><a class:list={['home-link', { active: !section }]} href={path(locale)} aria-current={!section ? 'page' : undefined}>{t.home}</a><div class="nav-sections">{navPaths.map((navPath, i) => <a href={path(locale, navPath)} class:list={{ active: section === navPath }} aria-current={section === navPath ? 'page' : undefined}>{t.nav[i]}</a>)}</div><a class="official-link" href={`https://silverpalace.elementagames.com/${locale === 'en' ? 'en-us' : 'ja-jp'}/`} target="_blank" rel="noopener noreferrer">{t.official}<Icon name="diagonal" size={13}/></a></nav></div>
    </header>
    <main id="main"><slot /></main>
    <footer data-pagefind-ignore><div class="shell footer-top"><SiteBrand locale={locale} footer/><p>{t.footer}</p><div><a href={path(locale, 'about')}>{t.about}</a><a href={path(locale, 'privacy')}>{t.privacy}</a></div></div><div class="shell footer-bottom"><p>{t.disclaimer}</p><span>© 2026 Silver Palace Guide</span></div></footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      menu?.addEventListener('click', () => { const expanded = menu.getAttribute('aria-expanded') === 'true'; menu.setAttribute('aria-expanded', String(!expanded)); document.querySelector('.nav-wrap')?.classList.toggle('is-open', !expanded); });
      document.addEventListener('keydown', (event) => {
        const target = event.target as HTMLElement;
        if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !target.closest('input, textarea, select, [contenteditable="true"], dialog[open]')) { event.preventDefault(); document.querySelector<HTMLAnchorElement>('.search-link')?.click(); }
        if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
          const focusWasInNavigation = document.querySelector('.nav-wrap')?.contains(document.activeElement);
          menu.setAttribute('aria-expanded', 'false'); document.querySelector('.nav-wrap')?.classList.remove('is-open');
          if (focusWasInNavigation) menu.focus();
        }
      });
    </script>
  </body>
</html>
