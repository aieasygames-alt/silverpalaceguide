---
import Icon from './Icon.astro';
import AnswerConfirmation from './AnswerConfirmation.astro';
import type { Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const en = locale === 'en';
const stages = en ? [
  { name: '01 — Put the cards in order', hint: 'Check the calendar date before comparing the hour.', evidence: 'Card A is dated 20 November. Card B is dated 21 November. The dates fall on consecutive days.', solution: 'Card A comes first. Its appointment is at 23:50 on 20 November, before Card B at 00:10 on 21 November.' },
  { name: '02 — Find the time between them', hint: 'Midnight makes a useful dividing point.', evidence: 'From 23:50 to midnight is ten minutes. From midnight to 00:10 is another ten minutes.', solution: 'The two appointments are twenty minutes apart. Add the ten minutes before midnight to the ten minutes after it.' },
] : [
  { name: '01 — カードを時間順に並べる', hint: '時刻を比べる前に、日付を確認してみましょう。', evidence: 'カードAは11月20日、カードBは11月21日です。日付は1日違います。', solution: '先なのはカードAです。11月20日の23:50は、11月21日の00:10より前になります。' },
  { name: '02 — ふたつの予定の間隔を調べる', hint: '午前0時で区切ると、考えやすくなります。', evidence: '23:50から午前0時までが10分。午前0時から00:10までも10分です。', solution: 'ふたつの予定の間隔は20分です。午前0時の前後にある10分ずつを足して求めます。' },
];
const labels = en ? ['A gentle nudge', 'A closer look', 'The full explanation'] : ['小さなヒント', 'もう少し詳しく', '詳しい解説'];
---
<section id="hint-demo" data-locale={locale} data-pagefind-ignore>
  <div class="panel-title"><h2>{en ? 'The appointment cards' : '2枚の予定カード'}</h2><span class="pill">{en ? 'READING EXERCISE' : '読み方の練習'}</span></div>
  <p class="tiny">{en ? 'An original exercise to demonstrate the controls. This is not a Silver Palace case or gameplay evidence.' : '操作を試すためのオリジナル問題です。白銀の城に登場する事件や、ゲーム内資料ではありません。'}</p>
  <div class="exercise-cards"><div><span>{en ? 'CARD A' : 'カードA'}</span><strong>20 NOV</strong><span>23:50</span></div><div><span>{en ? 'CARD B' : 'カードB'}</span><strong>21 NOV</strong><span>00:10</span></div></div>
  <label class="field-label" for="hint-stage">{en ? 'Choose a question' : '調べたい問いを選ぶ'}</label><select id="hint-stage" class="stage-select field">{stages.map((stage, i) => <option value={i}>{stage.name}</option>)}</select>
  {stages.map((stage, i) => <div data-stage={i} hidden={i !== 0}>{[stage.hint, stage.evidence, stage.solution].map((content, j) => <details class="hint-step" data-level={j + 1}><summary><span>0{j + 1}</span><span>{labels[j]}</span>{j === 2 && <span class="tiny">{en ? 'Spoilers' : 'ネタバレ'}</span>}<Icon name="plus" size={18}/></summary><div class="hint-content">{content}</div></details>)}</div>)}
  <div class="button-row"><button type="button" class="text-link" id="hide-hints">{en ? 'Hide all hints' : 'すべてのヒントを隠す'}<Icon name="x" size={15}/></button></div>
  <p class="status-message" id="hint-status" role="status" aria-live="polite"></p>
  <AnswerConfirmation locale={locale} titleId="exercise-answer-title"/>
</section>
<script>
  import { setupAnswerConfirmation } from '../lib/answer-confirmation';
  const root = document.querySelector<HTMLElement>('#hint-demo');
  if (root) {
    const en = root.dataset.locale === 'en';
    const status = root.querySelector<HTMLElement>('#hint-status')!;
    function hideAll() { root!.querySelectorAll<HTMLDetailsElement>('details').forEach((detail) => detail.open = false); }
    root.querySelector('#hide-hints')?.addEventListener('click', () => { hideAll(); status.textContent = en ? 'All hints are hidden again.' : 'すべてのヒントを隠しました。'; });
    root.querySelector<HTMLSelectElement>('#hint-stage')?.addEventListener('change', (event) => {
      hideAll();
      const selected = (event.target as HTMLSelectElement).value;
      root.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => stage.hidden = stage.dataset.stage !== selected);
      status.textContent = en ? 'Question changed. Hints start closed.' : '問いを切り替えました。ヒントは閉じた状態です。';
    });
    setupAnswerConfirmation(root);
  }
</script>
