---
import Base from '../../../layouts/Base.astro';
import PageHeading from '../../../components/PageHeading.astro';
import SourceList from '../../../components/SourceList.astro';
import { rewardEvent, rewardSlots } from '../../../lib/event-rewards';
import { locales, path, type Locale } from '../../../lib/i18n';
import '../../../styles/reference.css';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
---
<Base locale={locale} title={en ? 'Mystery Unveiled reward planner' : '難事件発生の報酬選択プランナー'} description={en ? 'Record your Mystery Unveiled draws, prepare up to six reward entries, total matching items and check official deadlines in your timezone.' : '「難事件発生」で獲得したアイテムを記録し、最大6点の受け取り候補と合計数を確認。公式の期限を現地時間で表示します。'} section="tools">
<div class="shell" id="reward-picker" data-locale={locale} data-pagefind-body>
  <PageHeading locale={locale} eyebrow={en ? 'THE WORKBENCH / PRE-LAUNCH EVENT' : '探偵の作業机 / 事前イベント'} title={en ? 'Ten entries. Your six choices.' : '10点から、6点を選ぶ。'} description={en ? 'A personal worksheet for Mystery Unveiled. Record the entries you have actually drawn, then prepare up to six to claim on the official event page.' : '「難事件発生」の個人用計画表です。実際に抽選で獲得したアイテムを記録し、公式イベントページで受け取る候補を最大6点まで選べます。'}/>
  <p class="notice">{en ? 'This worksheet records your choices in this browser. Draws and reward claims take place on the official event website. A tick here does not check your game account or claim an item.' : '選択内容はこのブラウザーに保存します。抽選と受け取りは公式イベントサイトで行ってください。ここでのチェックは、ゲームアカウントの確認や実際の報酬受け取りにはなりません。'}</p>
  <div class="reference-links"><a class="text-link" href={path(locale, 'guides/mystery-unveiled')}>{en ? 'Read the event guide →' : 'イベントガイドを読む →'}</a><a class="text-link" href={path(locale, 'tools/glossary')}>{en ? 'Look up an item name →' : 'アイテム名を調べる →'}</a></div>
  <div class="zone-control" data-pagefind-ignore><label class="field-label" for="event-zone">{en ? 'Display deadlines in' : '期限の表示タイムゾーン'}</label><select id="event-zone"><option value="Asia/Shanghai">UTC+8 / Shanghai</option><option value="Asia/Tokyo">Japan / Tokyo</option><option value="UTC">UTC</option><option value="America/Los_Angeles">US / Los Angeles</option><option value="America/New_York">US / New York</option><option value="Europe/London">UK / London</option><option value="Europe/Berlin">Europe / Berlin</option><option value="Australia/Sydney">Australia / Sydney</option></select></div>
  <div class="event-dates">
    <div><strong>{en ? 'Draw deadline' : '抽選終了'}</strong><time data-event-time datetime={rewardEvent.drawEndsAt}>2026-12-13 23:59 (UTC+8)</time><p class="tiny">{en ? 'Draw items expire when the event ends.' : '未使用の抽選アイテムは終了時に失効します。'}</p></div>
    <div><strong>{en ? 'Claim deadline' : '受け取り期限'}</strong><time data-event-time datetime={rewardEvent.claimEndsAt}>2026-12-29 10:00 (UTC+8)</time><p class="tiny">{en ? 'Claiming opens after game launch; the opening hour is unconfirmed here.' : '受け取りは正式サービス開始後に開放。開始時刻は未確認です。'}</p><a class="text-link" href={`/${locale}/events/mystery-unveiled.ics`} download>{en ? 'Download both calendar deadlines ↓' : '2つの期限をカレンダーファイルで保存 ↓'}</a></div>
  </div>
  <p id="event-phase" class="tiny" data-pagefind-ignore></p>
  <div class="reward-layout" data-pagefind-ignore>
    <section aria-labelledby="reward-roster-title"><h2 id="reward-roster-title">{en ? 'Your drawn entries' : '獲得したアイテム'}</h2><p class="tiny" style="margin:12px 0 20px">{en ? 'Mark “Drawn” first. Matching item names are separate pool entries, each taking one of your six claim slots.' : '先に「獲得済み」をチェック。同名のアイテムも別々の抽選枠で、受け取り候補ではそれぞれ1点と数えます。'}</p>
      <div class="reward-roster">{rewardSlots.map((slot, index) => <article class="reward-card" data-reward-card={slot.id}><span class="eyebrow">{en ? `POOL ENTRY ${String(index + 1).padStart(2,'0')}` : `抽選枠 ${String(index + 1).padStart(2,'0')}`}</span><h3>{slot.name[locale]}</h3><span class="reward-amount">×{slot.amount.toLocaleString(locale)}</span><p class="tiny">{en ? `Entry ${slot.copy} of ${rewardEvent.items.find(item => item.id === slot.itemId)!.copies} for this item` : `このアイテムの${rewardEvent.items.find(item => item.id === slot.itemId)!.copies}枠中${slot.copy}枠目`}</p><div class="reward-toggles"><label><input type="checkbox" data-reward-drawn={slot.id} disabled aria-label={`${slot.name[locale]} — ${slot.copy} — ${en ? 'Drawn' : '獲得済み'}`}/><span>{en ? 'Drawn on the official site' : '公式サイトで獲得済み'}</span></label><label><input type="checkbox" data-reward-selected={slot.id} disabled aria-label={`${slot.name[locale]} — ${slot.copy} — ${en ? 'Plan to claim' : '受け取り候補'}`}/><span>{en ? 'Plan to claim' : '受け取り候補にする'}</span></label></div></article>)}</div>
    </section>
    <aside class="panel reward-receipt" aria-labelledby="receipt-title"><span class="eyebrow">{en ? 'YOUR CLAIM WORKSHEET' : '受け取りの計画表'}</span><h2 id="receipt-title" style="margin-top:12px">{en ? 'Set aside your six.' : '受け取り候補。'}</h2><div class="receipt-count"><output id="reward-count" aria-live="polite">0 / 6</output><span class="tiny">{en ? 'entries selected' : '点を選択'}</span></div><p id="reward-drawn-count" class="tiny"></p><ul id="reward-totals" class="reward-totals"></ul><p id="reward-empty" class="tiny">{en ? 'Your selected quantities will appear here.' : '選択したアイテムの合計数をここに表示します。'}</p><p class="tiny">{en ? 'Removing a drawn entry also removes it from your planned claim. No item-value ranking is applied.' : '獲得済みのチェックを外すと、受け取り候補からも外れます。アイテムの価値や優先度は計算しません。'}</p><hr class="rule"/><label class="claim-note"><input type="checkbox" id="reward-claimed" disabled/><span>{en ? 'My note: I have completed the one-time claim on the official site.' : '自分用の記録：公式サイトで1回限りの受け取りを完了した。'}</span></label><a class="button" href={rewardEvent.officialUrl} rel="noopener noreferrer" target="_blank">{en ? 'Open the official event ↗' : '公式イベントを開く ↗'}</a><p class="tiny" style="margin-top:12px">{en ? 'Create your game character first. Confirm your recipient and chosen items carefully: the official claim cannot be changed afterward.' : '先にゲーム内キャラクターを作成。公式の受け取りでは、確定後に配布先と内容を変更できません。'}</p></aside>
  </div>
  <div class="reward-toolbar" data-pagefind-ignore><p id="reward-status" class="status-message" role="status" aria-live="polite"></p><div class="button-row"><button class="button secondary" id="reward-export" type="button">{en ? 'Export worksheet' : '計画を書き出す'}</button><button class="button secondary" id="reward-import" type="button">{en ? 'Import worksheet' : '計画を読み込む'}</button><button class="text-link" id="reward-clear" type="button">{en ? 'Clear worksheet' : '計画を消去'}</button></div><input type="file" id="reward-file" accept="application/json,.json" hidden aria-label={en ? 'Reward worksheet backup' : '報酬計画のバックアップ'}/></div>
  <section class="panel"><h2>{en ? 'What the pool contains' : '抽選アイテムの資料'}</h2><p style="margin-top:16px">{en ? 'The quantities above come from the official event rules checked on 22 November 2026. The Curiosity Mystery is described as a 4-star Motive. The other entries are identified by their official names; their upgrade uses, exchange values and farming costs are not established by these rules. These are event quantities, separate from the global pre-registration milestone campaign.' : '数量は2026年11月22日に確認した公式ルールに基づきます。「探求者の謎」は★4モーティヴとして紹介されています。ほかのアイテムは公式名で掲載していますが、育成での用途、交換価値、入手コストはこのルールからは確認できません。これは本イベントの数量で、グローバル事前登録キャンペーンとは別です。'}</p><a class="text-link" style="margin-top:16px" href={path(locale, 'tools/material-planner')}>{en ? 'Keep upgrade requirements in your material worksheet →' : '育成に必要な数は素材計画で管理 →'}</a></section>
  <SourceList locale={locale} ids={rewardEvent.sourceIds}/>
  <noscript><p class="notice">{en ? 'Enable JavaScript to use the worksheet and local timezone display. The official UTC+8 deadlines, calendar download and event guide remain available.' : '計画表と現地時間表示にはJavaScriptが必要です。UTC+8の公式期限、カレンダーファイル、イベントガイドはそのまま利用できます。'}</p></noscript>
</div>
</Base>
<script>
  import { rewardEvent, rewardSlots, REWARDS_KEY, emptyRewardPlan, validateRewardPlan, setRewardDrawn, setRewardSelected, selectedRewardTotals, eventPhase } from '../../../lib/event-rewards';
  import { readLocal, saveLocal, downloadJSON, parseBackup } from '../../../lib/local-data';
  const root = document.querySelector<HTMLElement>('#reward-picker');
  if (root) {
    const en = root.dataset.locale === 'en';
    const status = root.querySelector<HTMLElement>('#reward-status')!;
    const fileInput = root.querySelector<HTMLInputElement>('#reward-file')!;
    const claimed = root.querySelector<HTMLInputElement>('#reward-claimed')!;
    let plan = emptyRewardPlan(), warning = '';
    try { const stored = readLocal(REWARDS_KEY); if (stored !== null) plan = validateRewardPlan(stored); }
    catch { warning = en ? 'Saved worksheet could not be read. It has not been overwritten. Import a valid backup or make a new selection to start again.' : '保存された計画を読み取れません。上書きはしていません。正しいバックアップを読み込むか、新しく選択して開始してください。'; }
    function render() {
      rewardSlots.forEach((slot) => {
        const drawn = root!.querySelector<HTMLInputElement>(`[data-reward-drawn="${slot.id}"]`)!;
        const selected = root!.querySelector<HTMLInputElement>(`[data-reward-selected="${slot.id}"]`)!;
        drawn.disabled = false; drawn.checked = plan.drawn.includes(slot.id);
        selected.checked = plan.selected.includes(slot.id); selected.disabled = !drawn.checked || (!selected.checked && plan.selected.length >= rewardEvent.selectionLimit);
        root!.querySelector(`[data-reward-card="${slot.id}"]`)!.classList.toggle('is-selected', selected.checked);
      });
      claimed.disabled = false; claimed.checked = plan.claimed;
      root!.querySelector('#reward-count')!.textContent = `${plan.selected.length} / ${rewardEvent.selectionLimit}`;
      root!.querySelector('#reward-drawn-count')!.textContent = en ? `${plan.drawn.length} of 10 pool entries recorded as drawn.` : `全10枠中${plan.drawn.length}枠を獲得済みとして記録。`;
      const totals = selectedRewardTotals(plan), list = root!.querySelector('#reward-totals')!;
      list.replaceChildren();
      totals.forEach((item) => { const li = document.createElement('li'), name = document.createElement('span'), amount = document.createElement('strong'); name.textContent = item.name[en ? 'en' : 'ja']; amount.textContent = `×${item.total.toLocaleString(en ? 'en' : 'ja')}`; li.append(name, amount); list.append(li); });
      root!.querySelector<HTMLElement>('#reward-empty')!.hidden = totals.length > 0;
    }
    function persist() { warning = ''; status.textContent = saveLocal(REWARDS_KEY, plan) ? (en ? 'Saved in this browser. English and Japanese share this worksheet.' : 'このブラウザーに保存しました。英語と日本語で同じ計画を使えます。') : (en ? 'Browser storage is unavailable. Export the worksheet to keep a copy.' : 'ブラウザーに保存できません。書き出しで計画を残してください。'); }
    root.querySelectorAll<HTMLInputElement>('[data-reward-drawn]').forEach((input) => input.addEventListener('change', () => { plan = setRewardDrawn(plan, input.dataset.rewardDrawn!, input.checked); render(); persist(); }));
    root.querySelectorAll<HTMLInputElement>('[data-reward-selected]').forEach((input) => input.addEventListener('change', () => {
      try { plan = setRewardSelected(plan, input.dataset.rewardSelected!, input.checked); persist(); }
      catch { status.textContent = en ? 'Choose up to six entries you have recorded as drawn.' : '獲得済みのアイテムから最大6点まで選択できます。'; }
      render();
    }));
    claimed.addEventListener('change', () => { plan.claimed = claimed.checked; persist(); });
    root.querySelector('#reward-export')!.addEventListener('click', () => downloadJSON('silver-palace-event-rewards.json', plan));
    root.querySelector('#reward-import')!.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0]; if (!file) return;
      try { const imported = validateRewardPlan(await parseBackup(file)); if (window.confirm(en ? 'Replace this reward worksheet with the backup?' : 'バックアップで現在の報酬計画を置き換えますか？')) { plan = imported; render(); persist(); } }
      catch { status.textContent = en ? 'Unsupported reward backup. Your current worksheet has not changed.' : '対応する報酬計画ではありません。現在の計画は変更していません。'; }
      finally { fileInput.value = ''; }
    });
    root.querySelector('#reward-clear')!.addEventListener('click', () => { if (window.confirm(en ? 'Clear only this reward worksheet? Export a backup first if needed.' : 'この報酬計画だけを消去しますか？必要なら先に書き出してください。')) { plan = emptyRewardPlan(); render(); persist(); } });
    window.addEventListener('storage', (event) => { if (event.key === REWARDS_KEY || event.key === null) { try { const stored = readLocal(REWARDS_KEY); plan = stored === null ? emptyRewardPlan() : validateRewardPlan(stored); render(); status.textContent = en ? 'Worksheet refreshed from this browser.' : 'ブラウザーの最新の計画を反映しました。'; } catch { status.textContent = en ? 'Another tab saved an unreadable worksheet. Your current view is preserved.' : '別のタブの計画を読み取れません。現在の表示を保持しています。'; } } });
    const zone = root.querySelector<HTMLSelectElement>('#event-zone')!;
    const localZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    if (localZone && ![...zone.options].some(option => option.value === localZone)) zone.add(new Option(localZone, localZone));
    zone.value = localZone || 'Asia/Shanghai';
    function dates() {
      const formatter = new Intl.DateTimeFormat(en ? 'en-GB' : 'ja-JP', {timeZone:zone.value,year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',hourCycle:'h23',timeZoneName:'short'});
      root!.querySelectorAll<HTMLTimeElement>('[data-event-time]').forEach(time => time.textContent = formatter.format(new Date(time.dateTime)));
      const phase = eventPhase(Date.now());
      root!.querySelector('#event-phase')!.textContent = phase === 'drawing' ? (en ? 'The announced draw period is in progress. Deadlines use the timezone selected above.' : '発表された抽選期間中です。期限は上で選んだタイムゾーンで表示します。') : phase === 'ended' ? (en ? 'The published claim deadline has passed. This worksheet remains available as a personal record.' : '発表された受け取り期限は終了しました。計画表は個人の記録として利用できます。') : phase === 'upcoming' ? (en ? 'The announced draw period has not started.' : '発表された抽選期間はまだ始まっていません。') : (en ? 'The draw period has ended. Check the official page for claim opening and availability.' : '抽選期間は終了しました。受け取りの開始・利用状況は公式ページをご確認ください。');
    }
    zone.addEventListener('change', dates); dates(); setInterval(dates, 60_000);
    render(); status.textContent = warning || (en ? 'A personal record, saved only after you make a change. Export a backup to keep a copy.' : '個人用の記録です。変更するとブラウザーに保存します。書き出しでバックアップを残せます。');
  }
</script>
