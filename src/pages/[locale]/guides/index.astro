---
import Base from '../../../layouts/Base.astro';
import GameImage from '../../../components/GameImage.astro';
import PageHeading from '../../../components/PageHeading.astro';
import Icon from '../../../components/Icon.astro';
import { locales, path, type Locale } from '../../../lib/i18n';
import { publishedGuides } from '../../../lib/content';
import '../../../styles/guides.css';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
const guides = await publishedGuides(locale);
const beginner = guides.find(guide => guide.data.slug === 'beginner-guide');
const otherGuides = guides.filter(guide => guide !== beginner);
const title = en ? 'The reading room.' : '探偵の閲覧室。';
---
<Base locale={locale} title={en ? 'Guides' : 'ガイド'} description={en ? 'Source-backed launch preparation and practical guides to using your Silver Palace field notes and tools.' : '出典付きのリリース準備情報と、探索ノート・計画ツールの使い方。'} section="guides"><div class="shell" data-pagefind-body><PageHeading locale={locale} eyebrow={en ? 'FIELD GUIDES' : 'フィールドガイド'} title={title} description={en ? 'A few useful pages for the journey ahead. Every guide tells you what it is based on, and when it was checked.' : 'これからの冒険に役立つ読み物。各ガイドには、根拠となる資料と確認日を明記しています。'}/>{beginner && <section class="beginner-entry" aria-labelledby="beginner-entry-title"><div><span class="eyebrow">{en ? 'NEW TO SILVER PALACE?' : '白銀の城をこれから始める方へ'}</span><h2 id="beginner-entry-title">{en ? 'Start with a little direction.' : '最初の一歩に、道しるべを。'}</h2><p>{beginner.data.summary}</p></div><a class="button" href={path(locale, 'guides/beginner-guide')}>{en ? 'Read the beginner guide' : '初心者ガイドを読む'}<Icon name="arrow" size={17}/></a></section>}<div class="page-grid"><div class="guide-list">{otherGuides.map((guide, i) => <a class="guide-row" href={path(locale, `guides/${guide.data.slug}`)}><span class="number">{String(i + 1).padStart(2, '0')}</span><div><h3>{guide.data.title}</h3><p>{guide.data.summary}</p></div><Icon name="diagonal" size={18}/></a>)}</div><aside class="margin-note"><figure class="sidebar-art"><GameImage image="collage" locale={locale} sizes="(max-width: 600px) calc(100vw - 36px), (max-width: 800px) calc(100vw - 56px), 300px"/><figcaption>{en ? 'Silver Palace promotional artwork.' : '白銀の城の宣伝イラスト。'}</figcaption></figure><Icon name="book" size={25}/><span class="eyebrow">{en ? 'READ WITH CONFIDENCE' : '安心して読むために'}</span><h3>{en ? 'Context matters.' : '情報には、背景があります。'}</h3><p>{en ? 'An announcement is not a live test. We label sources and versions so you can tell the difference.' : '公式発表とプレイ検証は別のものです。出典と対象バージョンを示し、違いが分かるようにしています。'}</p><a class="text-link" href={path(locale, 'about')}>{en ? 'Read our policy' : '編集方針を読む'}<Icon name="arrow" size={16}/></a></aside></div></div></Base>
