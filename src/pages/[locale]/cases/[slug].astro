---
import Base from '../../../layouts/Base.astro';
import PageHeading from '../../../components/PageHeading.astro';
import CaseHints from '../../../components/CaseHints.astro';
import EvidenceImage from '../../../components/EvidenceImage.astro';
import EditorialStatus from '../../../components/EditorialStatus.astro';
import SourceList from '../../../components/SourceList.astro';
import { cases, publishedCases } from '../../../lib/game-content';
import { path } from '../../../lib/i18n';
export function getStaticPaths() { return publishedCases().map((entry) => ({ params: { locale: entry.locale, slug: entry.slug }, props: { entry } })); }
const { entry } = Astro.props;
const locale = entry.locale;
const en = locale === 'en';
const original = cases.find((candidate) => candidate.translationId === entry.translationId && candidate.locale === 'en');
---
<Base locale={locale} title={entry.title} description={entry.summary} section="cases"><div class="shell" data-pagefind-body><PageHeading locale={locale} eyebrow={en ? 'CASE FILE' : '事件ファイル'} title={entry.title} description={entry.summary}/><div class="page-grid"><article>
  <a class="text-link" href={path(locale, 'cases')}>{en ? '← All case notes' : '← 事件ノート一覧'}</a>
  <section class="panel prerequisites"><h2>{en ? 'Before you begin' : '始める前に'}</h2><ul>{entry.prerequisites.map((item) => <li>{item}</li>)}</ul></section>
  {entry.safeImageIds.map((id) => <EvidenceImage id={id} locale={locale}/>)}<CaseHints entry={entry}/><SourceList locale={locale} ids={entry.sourceIds}/>
</article><aside class="margin-note"><EditorialStatus locale={locale} entry={entry} original={original} originalHref={path('en', `cases/${entry.slug}`)} checkedAt={entry.checkedAt} server={entry.server} build={entry.build}/><hr class="rule"/><p>{en ? 'Choose a stage, then open only the help you need. Changing stage closes all hints.' : '必要な段階とヒントだけを開けます。段階を変えるとヒントはすべて閉じます。'}</p></aside></div></div></Base>
