---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { locales, text, path, type Locale } from '../../lib/i18n';
import { publishedGuides } from '../../lib/content';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const t = text[locale];
const en = locale === 'en';
const guides = (await publishedGuides(locale)).slice(0, 3);
const features = en ? [
  { icon: 'case', number: '01', title: 'Keep the mystery yours.', description: 'Start with a gentle nudge. Open the evidence and full explanation only when you want to.', link: 'Discover our hint system', suffix: 'cases', label: 'CASE NOTES' },
  { icon: 'compass', number: '02', title: 'Leave no loose ends.', description: 'Keep your own exploration notes and a checklist of places you want to return to.', link: 'Open your field notes', suffix: 'exploration', label: 'EXPLORATION' },
  { icon: 'planner', number: '03', title: 'Make a little progress.', description: 'Turn material requirements into a clear plan. Count what you have. See what you still need.', link: 'Make a material plan', suffix: 'tools/material-planner', label: 'PLANNING TOOLS' },
] : [
  { icon: 'case', number: '01', title: '謎を解く楽しみを、そのままに。', description: 'まずは小さなヒントから。証拠や詳しい解説は、必要になったときに開けます。', link: 'ヒントの仕組みを見る', suffix: 'cases', label: '事件ノート' },
  { icon: 'compass', number: '02', title: '気になる場所を、忘れずに。', description: '探索メモとチェックリストで、後から訪れたい場所や調べたいことを整理しましょう。', link: '探索ノートを開く', suffix: 'exploration', label: '探索' },
  { icon: 'planner', number: '03', title: '育成の準備を、少しずつ。', description: '必要数と所持数を入力して、足りない素材を確認。自分のペースで計画を立てられます。', link: '素材の計画を立てる', suffix: 'tools/material-planner', label: '計画ツール' },
];
---
<Base locale={locale} title="Silver Palace Guide" description={en ? 'An independent Silver Palace guide for curious detectives. Spoiler-conscious case hints, exploration notes and practical material planning, in English and Japanese.' : '白銀の城の非公式攻略ガイド。段階式ヒント、探索ノート、素材プランナーを英語・日本語でお届けします。'}>
  <div class="shell" data-pagefind-body>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy"><span class="eyebrow">{en ? 'THE DETECTIVE’S FIELD GUIDE' : '探偵のためのフィールドガイド'}</span><h1 id="hero-title" data-pagefind-meta="title">{en ? <>Find your way.<br/><em>Keep the wonder.</em></> : <>未知の街に、<br/><em>小さな道しるべ。</em></>}</h1><p>{en ? 'A companion for the curious. Thoughtful hints, useful field notes and a clearer path through Silver Palace.' : '好奇心の向かう先へ。段階式のヒント、役立つ探索ノート、育成の計画で、白銀の城での冒険を支えます。'}</p><div class="hero-actions"><a class="button" href={path(locale, 'guides/launch-preparation')}>{en ? 'Get ready for Silver Palace' : 'リリースに備える'}<Icon name="arrow" size={17}/></a><a class="text-link" href={path(locale, 'tools')}>{en ? 'Explore the tools' : 'ツールを見る'}<Icon name="diagonal" size={15}/></a></div></div>
      <figure class="hero-visual"><img src="/images/city-study.svg" width="760" height="650" fetchpriority="high" alt={en ? 'Original architectural illustration of an imagined Victorian city in green and brass.' : '深緑と真鍮色で描いた、架空のヴィクトリア風都市のオリジナルイラスト。'}/><span class="visual-stamp">SPG / FIELD ARCHIVE — VOL. 01</span><figcaption class="visual-caption"><span>{en ? 'An imagined city' : '想像の街並み'}<strong>{en ? 'A study in silver & shadow' : '銀と影のスケッチ'}</strong></span><span>{en ? 'Original illustration' : 'オリジナルイラスト'}<br/>51° / 026</span></figcaption></figure>
    </section>
    <div class="brief-strip"><span class="label">{en ? 'On the record' : '公式発表'}</span><p>{en ? 'Global launch announced for 14 December. Exact opening times are still to be confirmed.' : 'グローバルリリースは12月14日予定。詳しい開始時刻は公式発表をご確認ください。'}</p><a class="text-link" href={path(locale, 'guides/launch-preparation')}>{en ? 'Read the launch brief' : 'リリース情報'}<Icon name="arrow" size={14}/></a></div>
    <section class="section"><div class="section-head"><div><span class="eyebrow">{en ? 'A GOOD PLACE TO BEGIN' : '冒険の手がかり'}</span><h2>{en ? 'Follow your curiosity.' : '好奇心を、道しるべに。'}</h2></div><span class="tiny">{en ? 'Three ways to find your footing' : '冒険を支える、3つの入り口'}</span></div><div class="feature-grid">{features.map((feature, i) => <a class:list={['feature', { dark: i === 0 }]} href={path(locale, feature.suffix)}><div class="feature-top"><Icon name={feature.icon} size={27}/><span>{feature.number} / {feature.label}</span></div><h3>{feature.title}</h3><p>{feature.description}</p><div class="feature-bottom"><span>{feature.link}</span><Icon name="arrow" size={18}/></div></a>)}</div></section>
    <section class="section split-section"><div><div class="section-head"><div><span class="eyebrow">{en ? 'FROM THE READING ROOM' : '閲覧室より'}</span><h2>{en ? 'Before you step inside.' : '最初の一歩の、その前に。'}</h2></div><a class="text-link" href={path(locale, 'guides')}>{t.allGuides}<Icon name="arrow" size={15}/></a></div><div class="guide-list">{guides.map((guide, i) => <a class="guide-row" href={path(locale, `guides/${guide.data.slug}`)}><span class="number">0{i + 1}</span><div><h3>{guide.data.title}</h3><p>{guide.data.summary}</p></div><Icon name="diagonal" size={17}/></a>)}</div></div><aside class="margin-note"><Icon name="shield" size={26}/><span class="eyebrow">{en ? 'A NOTE IN THE MARGIN' : '編集部からのメモ'}</span><h3>{en ? 'Good guides earn your trust.' : '確かな情報を、ひとつずつ。'}</h3><p>{en ? 'We show our sources and separate announcements from tested gameplay. Case walkthroughs and character presets will appear as their data is verified.' : '出典を示し、公式発表と実際のプレイ検証を区別します。事件攻略やキャラクター別の育成データは、確認できたものから公開します。'}</p><a class="text-link" href={path(locale, 'about')}>{en ? 'Our editorial approach' : '編集方針について'}<Icon name="arrow" size={15}/></a></aside></section>
  </div>
</Base>
